/**
 * The prescriptive half of a {@link FailurePrediction}: what to do, how soon, and how much
 * risk it removes. Generated by {@link IlliniFixRiskEngine} from a failure-mode action
 * library; consumed by the asset page ("Recommended Action"), by
 * {@link IlliniFixOps#createDraftWorkOrder} and by the crew optimizer, which maximises
 * priorityScore x expectedRiskReduction per labour hour.
 */
entity type MaintenanceRecommendation {
  /** Asset the recommendation applies to. */
  asset: !MaintenanceAsset

  /** Prediction this recommendation was derived from. */
  prediction: FailurePrediction

  /** Concrete action, e.g. "Inspect motor assembly and bearing system". */
  recommendedAction: !string

  /** Urgency phrased for operators, e.g. "Within 24 hours", "Within 7 days", "Next scheduled PM". */
  recommendedTimeframe: string

  /** Evidence summary justifying the action (the contributing signals and supporting reports). */
  reason: string

  /** Expected labour time in minutes for the inspection / repair. */
  estimatedInspectionDuration: int

  /** Copy of the prediction's priority score so recommendations can be ranked without a join. */
  priorityScore: double

  /** Absolute reduction in failure probability expected from completing the action (e.g. 0.89 → 0.28 = 0.61). */
  expectedRiskReduction: double

  /** Failure probability expected after the action is completed. */
  projectedFailureProbability: double

  /** Crew skill needed; matched against {@link MaintenanceCrew#skills} by the planner. */
  requiredSkill: string enum('Electrical', 'Mechanical', 'HVAC', 'Plumbing', 'Elevator', 'General')

  /** True for the recommendation attached to the asset's current prediction. */
  isCurrent: boolean
}
